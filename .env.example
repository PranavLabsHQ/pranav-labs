# Public site URL used by deployment environments.
NEXT_PUBLIC_SITE_URL=https://pranav-labs.vercel.app

# Public WhatsApp number in international format, digits only or with +.
NEXT_PUBLIC_WHATSAPP_NUMBER=+910000000000

# Contact form delivery through Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@pranavlabs.com
CONTACT_FROM_EMAIL="Pranav Labs <hello@pranavlabs.com>"

# Optional production analytics and verification.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
